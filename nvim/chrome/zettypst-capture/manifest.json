{
  "manifest_version": 3,
  "name": "ZetTypst Capture",
  "description": "Capture web pages and PDFs into a local ZetTypst project.",
  "version": "0.3.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ZetTypst Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "key": "",
  "icons": {
    "128": "icon.png"
  }
}
